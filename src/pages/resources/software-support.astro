---
import '../../styles/pages/resources/software-support.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Wave from '../../components/Wave.astro';

const title = 'Software Support – JPEG XL';
const description =
  'Find applications, libraries, and tools that support JPEG XL encoding and decoding.';
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jpegxl.info/resources/software-support.html"
>
  <Fragment slot="head">
    <script is:inline type="module" src="https://caniuse-embed.vercel.app/embed.js"></script>

  </Fragment>
  <main id="main-content">
    <section class="section-hero hero-fullspan-graphic gradient-bottom">
      <div class="container-content-vflex padding-sides">
      <div class="container-content-vflex centered">
        <div class="wrapper-text color-gradient">
          <h1 class="display-xl-bold fill-gradient">Software Support</h1>
        </div>
        <div class="wrapper-text width-small">
          <h2 class="text-l-medium large">
            Standardized in 2022, JPEG&nbsp;XL is quickly gaining momentum. Major operating
            systems, web browsers, and image editing software are increasingly adopting support for
            this efficient compression technology.
          </h2>
        </div>
      </div>
      </div>
    <div class="container-wave-animated">
      <div class="wrapper-content-wave centered align-middle height-cropped-width-full">
        <Wave />
      </div>
    </div>
    </section>
    <div class="section-content-wrapper height-100 centered padding-top_bottom">
      <section class="container-content-vflex width-page-max centered">
      <div class="container-content-vflex width-page-max">
        <div class="wrapper-content centered">
          <div class="group-container">
            <div class="text-xl-regular color-black">Libraries & APIs</div>
            <div class="container-logos">
              <div class="wrapper-logo-text">
                <a
                  href="https://github.com/libjxl/libjxl"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wrapper-logo-software-link w-inline-block"
                  ><img
                    src="/images/libjxl-logo.svg"
                    loading="lazy"
                    width="140"
                    alt="libjxl logo"
                    class="image-logo-software"
                  /></a
                >
                <div class="text-small-regular centered color-black">
                  <a
                    href="https://github.com/libjxl/libjxl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline"
                    >libjxl:
                  </a>JPEG XL reference implementation (C++)<br />
                  <a
                    href="https://artifacts.lucaversari.it/libjxl/libjxl/latest/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">Nightly Dev Builds</a
                  ><br />
                  <div class="spacer-2rem"></div>
                  <a
                    href="https://github.com/libjxl/jxl-rs"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">jxl-rs</a
                  > Rust decoder<br />‍
                  <a
                    href="https://github.com/Traneptora/jxlatte"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">jxlatte:</a
                  > Java decoder<br />‍
                  <a
                    href="https://github.com/tirr-c/jxl-oxide"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">jxl-oxide:‍</a
                  > Rust decoder<br />
                  <a
                    href="https://github.com/awxkee/jixel"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">jixel:</a
                  > Compact encoder in Rust by awxkee<br />
                </div>
              </div>
            </div>
          </div>
          <div class="spacer-2rem"></div>
          <div class="group-container">
            <div class="text-xl-regular color-black">Operating Systems</div>
            <div class="container-logos">
              <div class="wrapper-logo-text">
                <a
                  href="https://www.apple.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wrapper-logo-software-link w-inline-block"
                  ><img
                    src="/images/sw_apple.svg"
                    loading="lazy"
                    width="120"
                    height="142.4636688232422"
                    alt="Apple Logo"
                    class="image-logo-software"
                  /></a
                >
                <div class="text-regular-semibold wrap-none centered color-black">Apple</div>
              </div>
              <div class="wrapper-logo-text">
                <a
                  href="https://en.wikipedia.org/wiki/MacOS_Sonoma"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wrapper-logo-software-link w-inline-block"
                  ><img
                    src="/images/sw_macOS.svg"
                    loading="lazy"
                    width="120"
                    height="123.4"
                    alt="MacOS Logo"
                    class="image-logo-software"
                  /></a
                >
                <div class="text-regular-semibold wrap-none centered color-black">macOS</div>
              </div>
              <div class="wrapper-logo-text">
                <a
                  href="https://en.wikipedia.org/wiki/IOS_17"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wrapper-logo-software-link w-inline-block"
                >
                  <picture>
                    <source srcset="/images/sw_iOS17.jxl" type="image/jxl" />
                    <source srcset="/images/sw_iOS17.webp" type="image/webp" />
                    <img
                      src="/images/sw_iOS17.png"
                      loading="lazy"
                      width="120"
                      height="120"
                      alt="Palemoon Logo"
                      class="image-logo-software"
                    />
                  </picture>
                </a>
                <div class="text-regular-semibold wrap-none centered color-black">iOS 17+</div>
              </div>
            </div>
            <div class="wrapper-text centered">
              <div class="container-text-shaded centered">
                <div class="text-regular-semibold color-black">Linux</div>
                <p class="text-small-regular centered color-black">JPEG XL is packaged across the major Linux distributions.</p>
                <ul class="linux-distributions text-small-regular color-black">
                  <li><strong>Arch Linux & derivatives</strong> —{' '}
                    <a href="https://archlinux.org/packages/extra/x86_64/libjxl/" target="_blank" rel="noopener noreferrer" class="link-text-body-underline">libjxl</a>{' '}
                    is available for Arch, Manjaro, and EndeavourOS, with support across FFmpeg, ImageMagick, and KDE.</li>
                  <li><strong>Fedora</strong> —{' '}
                    <a href="https://packages.fedoraproject.org/pkgs/jpegxl/" target="_blank" rel="noopener noreferrer" class="link-text-body-underline">Libraries, development packages, and tools</a>{' '}
                    are in the official repositories.</li>
                  <li><strong>Debian</strong> —{' '}
                    <a href="https://packages.debian.org/bookworm/libjxl-tools" target="_blank" rel="noopener noreferrer" class="link-text-body-underline">Command-line tools and libraries</a>{' '}
                    are available in Debian 12 and newer.</li>
                  <li><strong>Ubuntu & derivatives</strong> —{' '}
                    <a href="https://packages.ubuntu.com/noble/libjxl-dev" target="_blank" rel="noopener noreferrer" class="link-text-body-underline">Packages are available in Ubuntu 24.04 LTS and newer</a>.
                    For Mint, Pop!_OS, and Zorin OS, availability depends on the Ubuntu base.</li>
                  <li><strong>openSUSE</strong> — Check{' '}
                    <a href="https://software.opensuse.org/package/libjxl" target="_blank" rel="noopener noreferrer" class="link-text-body-underline">package availability</a>{' '}
                    for your Tumbleweed or Leap release.</li>
                  <li><strong>KaOS & OpenMandriva</strong> — Early adopters of JPEG XL viewing in Qt/KDE applications.</li>
                </ul>
                <p class="text-small-regular centered color-black">Image viewing and thumbnails depend on the application and installed desktop plugins.</p>
              </div>
            </div>
            <div class="wrapper-text centered">
              <div class="container-text-shaded centered">
                <div class="text-regular-semibold color-black">Desktop integration & plugins</div>
                <div class="text-small-regular centered color-black">
                  <a
                    href="https://github.com/novomesk/qt-jpegxl-image-plugin"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">Qt / KDE</a
                  >: plugin available<a href="https://github.com/novomesk/qt-jpegxl-image-plugin"
                    ><br />‍</a
                  >GDK-pixbuf: plugin available in libjxl repo<br />‍<a
                    href="https://ubuntuhandbook.org/index.php/2021/04/gthumb-3-11-3-adds-jpeg-xl-support/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">gThumb<br />‍</a
                  >
                  <a
                    href="https://github.com/yllan/JXLook"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">MacOS Viewer/QuickLook Plugin<br />‍</a
                  >
                  <a
                    href="https://github.com/mirillis/jpegxl-wic"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">Windows Imaging Component<br />‍</a
                  >
                  <a
                    href="https://github.com/saschanaz/jxl-winthumb"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">Windows Thumbnail Handler<br /></a
                  >
                  <a
                    href="https://www.enlightenment.org/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-text-body-underline">EFL</a
                  >
                  (supported since 1.27, no external plugin needed)
                </div>
              </div>
            </div>
          </div>
          <div class="spacer-2rem"></div>
          <div class="group-container">
            <div class="text-xl-regular color-black">Browser Support</div>
