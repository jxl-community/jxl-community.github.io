  <script>
    document.querySelectorAll<HTMLElement>('.browser-tooltip').forEach((browser) => {
      browser.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') browser.classList.add('tooltip-dismissed');
      });
      browser.addEventListener('mouseleave', () => browser.classList.remove('tooltip-dismissed'));
      browser.addEventListener('focusout', () => browser.classList.remove('tooltip-dismissed'));
    });

    const embed = document.querySelector('#ciu-embed-wrap .ciu-embed');

    if (embed) {
      // The third-party module may insert its frame before or after this script.
      const observer = new MutationObserver(labelFrame);

      function labelFrame() {
        const frame = embed?.querySelector('iframe');
        if (!frame) return;
        frame.title = 'JPEG XL browser support';
        observer.disconnect();
      }

      observer.observe(embed, { childList: true, subtree: true });
      labelFrame();
    }
  </script>
