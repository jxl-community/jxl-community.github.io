---
import '../../styles/pages/resources/software-support.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SoftwareEntry from '../../components/SoftwareEntry.astro';
import { software, categories, platforms, capabilities } from '../../data/software';
import { browsers, otherBrowsers, systems, linuxPackages } from '../../data/software-compatibility';

const entries = software.filter((entry) => entry.category !== 'demo');
const grouped = categories.map((category) => ({
  ...category,
  entries: entries
    .filter((entry) => entry.category === category.id || entry.also?.includes(category.id))
    .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' })),
}));
---

<BaseLayout
  title="Software Support – JPEG XL"
  description="Find JPEG XL viewers, editors, converters, libraries, and services by task, platform, and capability."
  canonical="https://jpegxl.info/resources/software-support.html"
>
  <main id="main-content" class="software-page">
    <header class="software-hero">
      <h1 class="display-xl-bold fill-gradient">Software Support</h1>
      <p class="software-hero-lede">Find the right tool for your JPEG XL workflow.</p>
      <p class="software-browser-check" data-browser-check hidden></p>
      <nav class="software-jump" aria-label="On this page">
        <a href="#compatibility">Browsers &amp; systems</a>
        <a href="#software-directory">Find software</a>
        <a href="/resources/external-tools.html">Demos &amp; experiments</a>
      </nav>
    </header>
    <div class="software-page-content">
      <section
        id="compatibility"
        class="software-compatibility"
        aria-labelledby="compatibility-title"
      >
        <div class="software-section-intro">
          <h2 id="compatibility-title">Browser compatibility</h2>
          <p>Find your browser and check the version you use.</p>
        </div>
        <ul class="compatibility-cards">
          {browsers.map((browser) => (
            <li class="compatibility-card">
              {browser.logo && (
                <img
                  class="compatibility-card-logo"
                  src={browser.logo}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                />
              )}
              <h3>{browser.name}</h3>
              <p>{browser.support}</p>
              <a href={browser.source.url}>{browser.source.label}</a>
              <ul class="browser-features" aria-label={`${browser.name} JPEG XL support`}>
                {browser.supported ? (
                  <>
                    <li data-supported="true">
                      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
                      Supported
                    </li>
                    <li data-supported={String(browser.animation)}>
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="1.5" y="3" width="13" height="10" rx="2" />
                        <path d="M6.5 6v4l3.5-2z" />
                      </svg>
                      Animation
                      {!browser.animation && <span class="sr-only">(unsupported)</span>}
                    </li>
                    <li data-supported={String(browser.hdr)}>
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <circle cx="8" cy="8" r="2.75" />
                        <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1" />
                      </svg>
                      HDR
                      {!browser.hdr && <span class="sr-only">(unsupported)</span>}
                    </li>
                  </>
                ) : (
                  <li data-supported="false" class="browser-feature-status">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" /></svg>
                    Unsupported
                  </li>
                )}
              </ul>
            </li>
          ))}
        </ul>
        <div class="compatibility-more">
          <h3>Other browsers</h3>
          <p>
            Modern builds of these browsers support JPEG XL.
          </p>
          <ul class="other-browsers">
            {otherBrowsers.map((browser) => (
              <li>
                <a href={browser.url}>
                  {browser.logo && (
                    <img src={browser.logo} alt="" width="40" height="40" loading="lazy" />
                  )}
                  <span class="other-browser-name">{browser.label}</span>
                  <span class="other-browser-note">{browser.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <p class="compatibility-note">
          For other versions and platforms, see the{' '}
          <a href="https://caniuse.com/jpegxl">full browser compatibility table</a> or{' '}
          <a href="/resources/jpeg-xl-test-page.html">test your browser</a>.
        </p>
      </section>

      <section
        id="system-compatibility"
        class="software-compatibility"
        aria-labelledby="system-compatibility-title"
      >
        <div class="software-section-intro">
          <h2 id="system-compatibility-title">System compatibility</h2>
          <p>
            App support and desktop integration depend on your operating system and installed
            packages.
          </p>
        </div>
        <ul class="compatibility-cards">
          {systems.map((system) => (
            <li class="compatibility-card">
              <h3>{system.name}</h3>
              <p>{system.support}</p>
              <a href={system.source.url}>{system.source.label}</a>
            </li>
          ))}
        </ul>
        <div class="compatibility-more">
          <h3>Linux packages</h3>
          <p>
            Mint, Pop!_OS, and Zorin OS availability depends on the Ubuntu base. Check your openSUSE
            release. KaOS and OpenMandriva also offer Qt/KDE integration.
          </p>
          <ul class="software-chip-links">
            {linuxPackages.map((link) => (
              <li>
                <a href={link.url}>
                  {link.logo && (
                    <img src={link.logo} alt="" width="20" height="20" loading="lazy" />
                  )}
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="software-directory" class="software-directory" aria-labelledby="directory-title">
        <div class="software-section-intro">
          <h2 id="directory-title">What would you like to do?</h2>
          <p>Browse by task, then narrow the list to your platform.</p>
        </div>
        <form
          class="software-filters"
          role="search"
          aria-label="Find JPEG XL software"
          data-software-filters
          hidden
        >
          <div class="software-search-field">
            <label for="software-search">Search software</label>
            <input
              id="software-search"
              name="q"
              type="search"
              placeholder="Name, task, or feature"
              autocomplete="off"
              aria-controls="software-results"
            />
          </div>
          <div>
            <label for="software-platform">Platform</label>
            <select id="software-platform" name="platform" aria-controls="software-results">
              <option value="">All platforms</option>
              {Object.entries(platforms).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="software-capability">Capability</label>
            <select id="software-capability" name="capability" aria-controls="software-results">
              <option value="">All capabilities</option>
              {Object.entries(capabilities).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <button type="reset" class="software-reset" hidden>
            Clear filters
          </button>
        </form>
        <p class="software-directory-note">
          Capability labels describe documented features. Unlabelled features may still be
          supported; check the project for your version, edition, and build.
        </p>
        <p
          class="software-result-count"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-result-count
        >
          {entries.length} tools across {categories.length} categories
        </p>
        <div class="software-directory-layout">
          <nav class="software-category-nav" aria-label="Software by task">
            <ul>
              {grouped.map((group) => (
                <li data-category-link={group.id}>
                  <a href={`#${group.id}`}>
                    {group.title}
                    <span
                      class="software-category-count"
                      aria-hidden="true"
                      data-category-count={group.id}
                    >
                      {group.entries.length}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="software-demos-link" href="/resources/external-tools.html">
              Demos &amp; experiments
            </a>
          </nav>
          <div id="software-results">
            <div class="software-empty" data-software-empty hidden>
              <h3>No matching software</h3>
              <p>Try a different name, platform, or capability.</p>
              <button type="button" data-clear-filters>
                Clear filters
              </button>
            </div>
            {grouped.map((group) => (
              <section
                id={group.id}
                class="software-group"
                aria-labelledby={`${group.id}-title`}
                data-software-group
              >
                <header>
                  <h2 id={`${group.id}-title`}>{group.title}</h2>
                  <p>{group.description}</p>
                </header>
                <div class="software-group-grid">
                  {group.entries.map((entry) => (
                    <SoftwareEntry entry={entry} primary={entry.category === group.id} />
                  ))}
                </div>
                {group.note && <p class="software-group-note">{group.note}</p>}
              </section>
            ))}
          </div>
        </div>
        <p class="software-contribution-note">
          Missing a tool or found an outdated detail?{' '}
          <a href="https://github.com/jxl-community/jxl-community.github.io/blob/main/docs/software-directory.md">
            Contribute a listing or correction
          </a>
          .
        </p>
      </section>
    </div>
  </main>
  <script>
    import '../../scripts/software-directory';
  </script>
</BaseLayout>
