---
import '../../styles/pages/resources/external-tools.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { software } from '../../data/software';

const demos = software
  .filter((entry) => entry.category === 'demo')
  .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
---

<BaseLayout
  title="Demos & Experiments – JPEG XL"
  description="Explore JPEG XL browser tests, progressive loading demos, lossless editing, and generative art."
  canonical="https://jpegxl.info/resources/external-tools.html"
>
  <PageHero
    title="Demos & experiments"
    subtitle="Explore progressive loading, browser tests, lossless editing, and generative art."
  />
  <div class="section-content-wrapper height-100 centered padding-top_bottom">
    <main class="container-content-vflex width-page-max centered">
      <div class="wrapper-content centered">
        <p class="tool-directory-link">
          Looking for an app, converter, or library?{' '}
          <a href="/resources/software-support.html#software-directory">
            Browse the software directory
          </a>
          .
        </p>
        <section class="tool-grid" aria-label="JPEG XL demos and experiments">
          {demos.map((demo) => (
            <article class="tool-card">
              <h2>
                <a
                  class="tool-card-title-link"
                  href={demo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {demo.name}
                </a>
              </h2>
              <p class="tool-card-description">{demo.description}</p>
              <p class="tool-card-url" aria-hidden="true">
                {new URL(demo.url).hostname.replace(/^www\./, '')}
              </p>
              {demo.contributors && (
                <p class="tool-card-contributor">
                  Contributor:{' '}
                  {demo.contributors.map((contributor, index) => (
                    <Fragment>
                      {index > 0 && ', '}
                      <a href={contributor.url} target="_blank" rel="noopener noreferrer">
                        {contributor.name}
                      </a>
                    </Fragment>
                  ))}
                </p>
              )}
            </article>
          ))}
        </section>
        <p class="tool-grid-note">
          These projects are independently developed and maintained by the community.
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
