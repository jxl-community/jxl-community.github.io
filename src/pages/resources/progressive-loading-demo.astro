---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import demoImages from '../../data/progressive-demo-images.json';
import '../../styles/progressive-loading-demo.css';
import Wave from '../../components/Wave.astro';

const title = 'Progressive Loading Demo – JPEG XL';
const description =
  'Scrub through a partially downloaded JPEG and JPEG XL file and watch what each format can actually put on screen, decoded live in your browser.';

/* The image set is generated, not hand-listed: `ssimu2-85/results.csv` is the
   output of the encode run, one row per source/codec/mode, every file tuned to
   land at ssimulacra2 85. Reading it at build time keeps the page and the encode
   in step — re-run the encoder, drop in a new CSV, and the picker follows.

   Codecs differ in which modes they even have, which is the point of the mode
   control being per-codec rather than a global toggle:

     JPEG      sequential | progressive
     JPEGli    sequential | progressive-level-2
     AVIF      standard   | progressive
     WebP      standard only
     JPEG XL   progressive only (the comparison pane)

   Worth knowing before reading the AVIF numbers: its "progressive" file really
   is layered (an `a1lx` box, base layer complete at 2.5% of the file), but no
   current browser paints that base layer — Chrome and Safari both show nothing
   until the final byte, exactly like the standard AVIF. The demo reports that
   rather than hiding it. */
const CSV = 'ssimu2-85/results.csv';
const DIR = 'ProgressiveDemoImages';
const filePath = (file: string) => path.join('public', DIR, file);

type Row = {
  source: string;
  codec: string;
  mode: string;
  ssimulacra2: string;
  bytes: string;
  file: string;
};

function readCsv(): Row[] {
  const text = fs.readFileSync(filePath(CSV), 'utf8').trim();
  const [head, ...lines] = text.split(/\r?\n/);
  const cols = head.split(',');
  return lines.map((line) => {
    // The `parameter` column contains semicolons but no commas, so a plain
    // split is safe here; assert the shape rather than trusting it.
    const cells = line.split(',');
    if (cells.length !== cols.length) {
      throw new Error(`${CSV}: expected ${cols.length} columns, got ${cells.length}`);
    }
    return Object.fromEntries(cols.map((c, i) => [c, cells[i]])) as Row;
  });
}

/* Pixel dimensions come from the JPEG's SOF marker so each pane can reserve the
   right aspect ratio before anything decodes. Walking the segment lengths is
   enough — no image library needed for a handful of build-time reads. */
function jpegSize(file: string) {
  const d = fs.readFileSync(filePath(file));
  let i = 2;
  while (i < d.length - 1 && d[i] === 0xff) {
    const marker = d[i + 1];
    if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
      return { height: d.readUInt16BE(i + 5), width: d.readUInt16BE(i + 7) };
    }
    i += 2 + d.readUInt16BE(i + 2);
  }
  throw new Error(`no SOF marker in ${file}`);
}

const asset = (file: string) => ({
  url: `/${DIR}/${file}`,
  size: fs.statSync(filePath(file)).size,
});

/* Titles, photographer names and photo links are authored, not derived: the
   filename carries a slug and an id but no title, and guessing either would put
   invented text on the page. `src/data/progressive-demo-images.json` holds them,
   and a source without an entry fails the build rather than falling back to a
   filename. */
function credit(source: string) {
  const entry = (demoImages.images as Record<string, { title: string; photographer: string; url: string }>)[
    source
  ];
  if (!entry) {
    throw new Error(
      `${source} has no entry in src/data/progressive-demo-images.json — add its title, photographer and Unsplash link.`,
    );
  }
  return entry;
}

// Codec -> the two modes it is offered under, and which CSV mode backs each.
// `label` is what the mode control says; a codec with one entry gets no choice.
/* Modes per codec. What each one does with a partial download is left to the
   browser to demonstrate rather than declared here — the answers differ by
   engine (Chrome paints a layered AVIF from its base layer, Safari does not)
   and an earlier hardcoded capability flag simply got it wrong. */
const CODECS = [
  { key: 'jpeg', label: 'JPEG', modes: [
      { key: 'sequential', label: 'Sequential', csv: 'sequential' },
      { key: 'progressive', label: 'Progressive', csv: 'progressive' },
    ] },
  { key: 'jpegli', label: 'JPEGli', modes: [
      { key: 'sequential', label: 'Sequential', csv: 'sequential' },
      { key: 'progressive', label: 'Progressive', csv: 'progressive-level-2' },
    ] },
  { key: 'avif', label: 'AVIF', modes: [
      { key: 'sequential', label: 'Standard', csv: 'standard' },
      { key: 'progressive', label: 'Progressive', csv: 'progressive' },
    ] },
  { key: 'webp', label: 'WebP', modes: [
      { key: 'sequential', label: 'Standard', csv: 'standard' },
    ] },
];

const CSV_CODEC: Record<string, string> = {
  jpeg: 'JPEG',
  jpegli: 'JPEGli',
  avif: 'AVIF',
  webp: 'WebP',
};

const rows = readCsv();
const sources = [...new Set(rows.map((r) => r.source))].sort();

const images = sources.map((source) => {
  const mine = rows.filter((r) => r.source === source);
  const pick = (codec: string, mode: string) =>
    mine.find((r) => r.codec === codec && r.mode === mode);

  // JPEG XL is the fixed comparison pane. Its mode name varies across the set
  // (`progressive` or `progressive-center-first`), so match on codec alone.
  const jxlRow = mine.find((r) => r.codec === 'JPEG XL');
  if (!jxlRow) throw new Error(`${source}: no JPEG XL row`);

  const variants: Record<string, { url: string; size: number; ssimulacra2: number }> = {};
  for (const codec of CODECS) {
    for (const mode of codec.modes) {
      const row = pick(CSV_CODEC[codec.key], mode.csv);
      if (!row) throw new Error(`${source}: no ${codec.label} / ${mode.csv} row`);
      const rel = row.file.replace(/^ssimu2-85\//, 'ssimu2-85/');
      variants[`${codec.key}:${mode.key}`] = {
        ...asset(rel),
        ssimulacra2: Number(row.ssimulacra2),
      };
    }
  }

  const jpegRef = pick('JPEG', 'sequential');
  return {
    key: source.replace(/\.png$/, ''),
    ...credit(source),
    ...jpegSize(jpegRef!.file.replace(/^ssimu2-85\//, 'ssimu2-85/')),
    variants,
    jxl: { ...asset(jxlRow.file.replace(/^ssimu2-85\//, 'ssimu2-85/')), ssimulacra2: Number(jxlRow.ssimulacra2) },
  };
});

const manifest = { codecs: CODECS, images };
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://jpegxl.info/resources/progressive-loading-demo.html"
>
  <section id="main-content" class="section-hero hero-fullspan-graphic gradient-bottom">
    <div class="container-content-vflex width-page-max centered">
      <div class="wrapper-text color-gradient _40em">
        <h1 class="display-xl-bold fill-gradient">Progressive Loading Demo</h1>
      </div>
      <div class="wrapper-text width-small">
        <h2 class="text-l-medium large">
          Drag the slider to partially download an image and see what each format can put on screen
          with only those bytes, decoded live in the browser.
        </h2>
      </div>
    </div>
    <div class="container-wave-animated">
      <div class="wrapper-content-wave centered align-middle height-cropped-width-full">
        <Wave />
      </div>
    </div>
  </section>

  <div class="section-content-wrapper height-100 centered padding-top_bottom">
    <main class="container-content-vflex width-page-max centered">
      <div id="progressive-demo" class="pd-shell">
        <div class="pd-controls">
          <div class="pd-control">
            <label class="pd-control-label" for="pd-image-picker">Image</label>
            <select id="pd-image-picker" class="pd-select">
              {manifest.images.map((image) => (
                <option value={image.key}>{image.title}</option>
              ))}
            </select>
          </div>
          <div class="pd-control">
            <label class="pd-control-label" for="pd-codec-picker">Compare against</label>
            <select id="pd-codec-picker" class="pd-select">
              {manifest.codecs.map((codec) => <option value={codec.key}>{codec.label}</option>)}
            </select>
          </div>
          {/* Buttons are written for the widest case and relabelled per codec:
              JPEG and JPEGli call it Sequential/Progressive, AVIF calls it
              Standard/Progressive, and WebP has only one mode so the whole
              control is disabled rather than offering a choice that does
              nothing. */}
          <div class="pd-control">
            <span class="pd-control-label" id="pd-mode-label">Encoding</span>
            <div class="pd-toggle-group" role="group" aria-labelledby="pd-mode-label">
              <button
                type="button"
                class="pd-toggle is-selected"
                data-mode="sequential"
                aria-pressed="true"
              >
                Sequential
              </button>
              <button type="button" class="pd-toggle" data-mode="progressive" aria-pressed="false">
                Progressive
              </button>
            </div>
          </div>
          <div class="pd-control">
            <span class="pd-control-label">Playback</span>
            <button type="button" id="pd-play" class="pd-play" aria-pressed="false">Play</button>
          </div>
        </div>

        <div class="pd-panes" id="pd-panes">
          <div class="pd-pane">
            <div class="pd-pane-head">
              <div class="div-container-rounded_text_box">
                <h3 class="label-menu-text" id="pd-jpeg-label">JPEG</h3>
              </div>
            </div>
            <!-- A single <img> fed by a streaming response from
                 pd-stream-sw.js, not a canvas. The download is deliberately
                 left in flight, and drawImage is a no-op for an image whose
                 load has not completed — so the element has to do the drawing.
                 Its src only changes when the stream restarts (a backwards
                 drag), so there is no per-frame swap to band. -->
            <!-- The description lives on the stage, not on the <img>, and the
                 image is marked decorative. An <img> renders its alt text
                 whenever it has no pixels — which here is every codec switch and
                 every restart — so a real alt string put a line of text and a
                 broken-image icon across the pane. A canvas never did that,
                 which is why this only appeared once the pane became an <img>. -->
            <div class="pd-stage" id="pd-src-stage" role="img" aria-label="">
              <img id="pd-src-img" class="pd-src-img" alt=""
                src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
            </div>
            <div class="pd-readout" id="pd-jpeg-readout">
              <div class="pd-figure">
                <p class="headline-l-semibold pd-received-value" id="pd-jpeg-bytes">0</p>
                <p class="headline-s-semibold pd-received-unit">B</p>
              </div>
              <p class="pd-total" id="pd-jpeg-total"></p>
              <p class="pd-state" id="pd-jpeg-state"></p>
            </div>
          </div>

          <div class="pd-pane">
            <!-- Mirrored, so the two pills sit at the outer edges of the pair
                 the way the homepage comparison labels do. -->
            <div class="pd-pane-head is-mirrored">
              <div class="div-container-rounded_text_box">
                <h3 class="label-menu-text">JPEG&nbsp;XL</h3>
              </div>
            </div>
            <div class="pd-stage">
              <canvas id="pd-jxl-canvas" width="896" height="1080" role="img" aria-label=""
              ></canvas>
            </div>
            <div class="pd-readout is-mirrored" id="pd-jxl-readout">
              <div class="pd-figure">
                <p class="headline-l-semibold pd-received-value" id="pd-jxl-bytes">0</p>
                <p class="headline-s-semibold pd-received-unit">B</p>
              </div>
              <p class="pd-total" id="pd-jxl-total"></p>
              <p class="pd-state" id="pd-jxl-state"></p>
            </div>
          </div>
        </div>

        <div class="pd-transport">
          <label class="visually-hidden" for="pd-slider">Bytes received</label>
          <input type="range" id="pd-slider" class="pd-slider" min="0" max="100" value="0" />
          <span class="pd-received" id="pd-received"></span>
        </div>

        <p class="pd-status" id="pd-status" hidden></p>
        <p class="pd-meta" id="pd-meta"></p>
        <p class="pd-credit" id="pd-credit"></p>
      </div>

    </main>
  </div>

  <script
    type="application/json"
    id="progressive-demo-data"
    is:inline
    set:html={JSON.stringify(manifest)}
  />
  <script is:inline src="/resources/ProgressiveLoadingDemo.js"></script>
</BaseLayout>
