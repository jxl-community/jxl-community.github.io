        </div>
        <div class="spacer-4rem"></div>
        <div class="spacer-4rem"></div>
        <dialog id="enlarged-image-dialog" class="enlarged-image-dialog" aria-labelledby="enlarged-image-description">
            <button type="button" class="enlarged-image-close" aria-label="Close enlarged image">×</button>
            <img class="enlarged-image" src="" alt="">
            <p id="enlarged-image-description" class="sr-only">Enlarged test image</p>
        </dialog>
<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
            var dialog = document.getElementById('enlarged-image-dialog');
            var dialogImage = dialog.querySelector('.enlarged-image');
            var dialogDescription = document.getElementById('enlarged-image-description');
            var closeButton = dialog.querySelector('.enlarged-image-close');

            function openImage(image) {
                dialogImage.src = image.currentSrc || image.src;
                dialogImage.alt = image.alt || 'Enlarged test image';
                dialogDescription.textContent = dialogImage.alt;
                dialog.showModal();
                closeButton.focus();
            }

            document.querySelectorAll('.image-grid-container .image-container img').forEach(function (image) {
                image.tabIndex = 0;
                image.setAttribute('role', 'button');
                image.setAttribute('aria-haspopup', 'dialog');
                image.setAttribute('aria-label', 'Enlarge ' + (image.alt || 'test image'));
                image.addEventListener('click', function () { openImage(image); });
                image.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        openImage(image);
                    }
                });
            });

            closeButton.addEventListener('click', function () { dialog.close(); });
            dialog.addEventListener('click', function (event) {
                if (event.target === dialog) dialog.close();
            });
        });
</script>
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('compute-headroom-button').onmousemove = e => {
                const rect = e.target.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                e.target.style.setProperty('--x', `${x}px`);
                e.target.style.setProperty('--y', `${y}px`);
            };
        });
</script>
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
            const browserLinks = document.querySelectorAll('.browser-link');
            const browserLinkStatus = document.querySelector<HTMLElement>('#browser-link-status');

            browserLinks.forEach(link => {
                link.addEventListener('click', () => {
                    const url = link.getAttribute('data-url');
                    if (!url) return;
                    navigator.clipboard.writeText(url).then(() => {
                        const tooltip = document.createElement('span');
                        tooltip.className = 'tooltiptext';
                        tooltip.textContent = 'Copied!';
                        link.classList.add('tooltip');
                        link.appendChild(tooltip);
                        if (browserLinkStatus) browserLinkStatus.textContent = `${link.textContent} flag URL copied.`;

                        setTimeout(() => {
                            tooltip.remove();
                            link.classList.remove('tooltip');
                        }, 2000);
                    }).catch(() => {
                        if (browserLinkStatus) browserLinkStatus.textContent = 'Unable to copy the flag URL.';
                    });
                });
            });
        });
</script>
</BaseLayout>
